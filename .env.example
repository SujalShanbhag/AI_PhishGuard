# AI PhishGuard — Environment Configuration Template
APP_NAME="AI PhishGuard"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
APP_SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars!

# Database
DATABASE_URL=sqlite:///./data/veritas.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/veritas_db

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-different-secret-key-at-least-32-chars!
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# Upload and Storage Limits (MB)
MAX_IMAGE_SIZE_MB=15
MAX_VIDEO_SIZE_MB=250
MAX_AUDIO_SIZE_MB=50

# Model Configuration
DEEPFAKE_MODEL_PATH=./data/models/veritas_detector.pt
DEEPFAKE_MODEL_ARCH=efficientnet_b4
FACE_DETECTION_BACKEND=opencv
GRADCAM_ENABLED=true

# Decision Thresholds
SUSPICIOUS_THRESHOLD=0.65
AUTHENTIC_THRESHOLD=0.35

# CORS Origins
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Google Gemini AI Copilot
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
